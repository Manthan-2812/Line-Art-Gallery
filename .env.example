# ─────────────────────────────────────────────────────────────────────────────
# Line and Layer Art Gallery — Environment Variables (TEMPLATE)
#
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
# On Netlify, set these under: Site settings → Environment variables.
#
# NOTE ON PREFIXES:
#   Variables that are SAFE for the browser are prefixed and injected into
#   frontend config explicitly. Everything WITHOUT a "PUBLIC" note is
#   SERVER-ONLY and must never appear in client-side JavaScript.
# ─────────────────────────────────────────────────────────────────────────────

# ── Clerk (Authentication) ──────────────────────────────────────────────────
# Publishable key is PUBLIC (safe in browser). Secret key is SERVER-ONLY.
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# ── Razorpay (Payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Product Prices (INR) — placeholders X and Y from the spec ────────────────
# Framed Print 11x14 — server-side price (source of truth, INR)
PRICE_FRAME_11X14=900

# ── QikInk (Fulfillment) — used in Stage 9 ───────────────────────────────────
QIKINK_CLIENT_ID=your_qikink_client_id
QIKINK_CLIENT_SECRET=your_qikink_client_secret
QIKINK_BASE_URL=https://sandbox.qikink.com
QIKINK_SKU=UFPos-Bk-11x14Fpos
QIKINK_PRINT_TYPE_ID=1

# ── Admin identity — email that unlocks admin controls (ties to Clerk in S2/3)─
ADMIN_EMAIL=you@example.com

# ── Firebase Admin (server-side Firestore writes) ────────────────────────────
# From Firebase Console → Project settings → Service accounts → Generate key.
# Keep the private key on ONE line, double-quoted, with literal \n newlines.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...your...key...here...\n-----END PRIVATE KEY-----\n"
